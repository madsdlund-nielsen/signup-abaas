{
  "name": "signup-abaas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:all": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d && node tests/scripts/wait-for-db.mjs",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:link": "npx --yes supabase link",
    "db:push": "npx --yes supabase db push",
    "db:diff": "npx --yes supabase db diff",
    "db:seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "db:seed:demo:clean": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs clean",
    "launch:check": "node --env-file-if-exists=.env.local scripts/launch-check.mjs",
    "docs:reference": "node scripts/gen-reference.mjs",
    "e2e:db:up": "npx --yes supabase start --workdir tests/e2e",
    "e2e:db:down": "npx --yes supabase stop --workdir tests/e2e --no-backup",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "~16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "~16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
