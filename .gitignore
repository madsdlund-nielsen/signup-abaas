# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ALLE .env-varianter undtagen skabelonen.
# push protection fanger kendte nøgleformater, men ikke fx en DATABASE_URL med password.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e (fase 6.1, ADR 0071): kørselsartefakter. Skærmbilleder gemmes som CI-artefakt, ikke i git.
/tests/e2e/__screens__/
/tests/e2e/.runtime/
/playwright-report/
/test-results/
# lokal Supabase-CLI-tilstand for e2e-stakken (config.toml er committet; .temp/.branches er ikke)
/tests/e2e/supabase/.temp/
/tests/e2e/supabase/.branches/
