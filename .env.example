# ─────────────────────────────────────────────────────────────────────────────
# ABaaS — miljøvariabler (eksempel). Kopiér til .env.local og udfyld.
#
# INGEN rigtige secrets i repo (.gitignore dækker .env*). Alle nøgler nedenfor
# afventer account-oprettelse — ejerne opretter accounts og giver Mads adgang.
# Indtil da kører hver sub-processor-adapter som STUB, og feature-flagene er OFF.
# Prod-runtime-secrets sættes i Netlify > Environment variables (hosting = Netlify, ADR 0012).
# ─────────────────────────────────────────────────────────────────────────────

# --- Feature-flags (default OFF; sæt =true for at aktivere en konfigureret adapter) ---
FLAG_BOOKING=
FLAG_VIDEO=
FLAG_PAYMENTS=
FLAG_ACCOUNTING=
FLAG_AIFOLLOWUP=
FLAG_TRANSCRIPTION=
FLAG_EMAIL=
FLAG_SMS=
FLAG_ANALYTICS=
# inAppMessaging udelades bevidst — modulet er uafklaret og kan ikke aktiveres via env.

# --- Database (Supabase Postgres) — region eu-north-1 (Stockholm), jf. ADR 0013 ---
DATABASE_URL=
# db-tests mod lokal Postgres-container (docker-compose.test.yml):
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abaas_test

# --- Supabase Auth (auth-valg = Supabase Auth, ADR 0013) ---
# URL + anon-nøgle er offentlige by design (klient-eksponeret via NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role-nøgle: SERVER-ONLY hemmelighed — ALDRIG NEXT_PUBLIC_. Bruges kun server-side
# til rolle-opslag (bypasser RLS bevidst). Uden alle tre kører auth som stub (kontofri CI).
SUPABASE_SERVICE_ROLE_KEY=

# --- Adgangsport (ADR 0020) — delt adgangskode før auth. BRUGES IKKE p.t. (Mads, 2026-08-26);
# variablerne er dokumenteret her fordi koden findes. Alle tre skal sættes for at porten er aktiv.
# Hash genereres med `node scripts/hash-gate-password.mjs <kodeord>` — aldrig kodeordet i klartekst.
APP_GATE_ENABLED=
APP_GATE_PASSWORD_HASH=
APP_GATE_COOKIE_SECRET=

# --- Cal.com (booking, fase 2) — adapter bygget; liveverifikation afventer nøgler.
# Plan-/tier-valg (pris + EU-residens) er ejer/Mads — se docs/spikes/multi-host.md.
CALCOM_API_KEY=
# Multi-host event type-id som bookinger oprettes mod.
CALCOM_EVENT_TYPE_ID=
# Valgfri: afviger ved cal.eu/self-host (default https://api.cal.com/v2).
CALCOM_API_URL=
# Webhook-signaturhemmelighed (SERVER-ONLY). Uden den svarer webhook-endpointet 503 —
# signaturverifikation stubbes aldrig (docs/stub-politik.md, ADR 0027).
CALCOM_WEBHOOK_SECRET=

# --- Cal Video (multi-party video; optagelse ejes af Cal.com) ---
CALVIDEO_API_KEY=

# --- Alunta (betaling ind, ADR 0023/0032) — dansk udbyder; dataflow verificeret mod
# OpenAPI-spec'en. Bearer-token fra Alunta (Laravel Passport OAuth2).
ALUNTA_API_KEY=
# Den usage-baserede plan checkout-sessions oprettes mod. Opsættes i Alunta-UI med
# parameteren meeting_fee_oere til enhedspris 1 øre (vores pricing_rule beregner beløbet).
ALUNTA_PLAN_ID=
# Valgfri: afviger kun ved test-/self-host (default https://app.alunta.com/api/v1).
ALUNTA_API_URL=
# Webhook-signaturhemmelighed (SERVER-ONLY; sættes også i Alunta-UI'ets webhook-opsætning).
# Uden den svarer webhook-endpointet 503 — signaturverifikation stubbes aldrig (ADR 0027).
ALUNTA_WEBHOOK_SECRET=

# --- Bogføring ud (e-conomic ELLER Dinero — leverandørvalg uafklaret) ---
ACCOUNTING_API_KEY=

# --- LLM (Anthropic Claude API eller EU-hostet — EU-residens/DPA uafklaret) ---
LLM_API_KEY=

# --- Transskription (dansk/EU-udbyder uafklaret) ---
TRANSCRIPTION_API_KEY=

# --- Resend (transaktionsmails, EU Dublin) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- inMobile (SMS, dansk) ---
INMOBILE_API_KEY=
INMOBILE_SENDER=

# --- PostHog (analytics + fejlovervågning, EU) — fase 0, live-nøgle afventer ---
POSTHOG_KEY=
POSTHOG_HOST=https://eu.posthog.com
