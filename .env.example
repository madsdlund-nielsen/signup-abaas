# ─────────────────────────────────────────────────────────────────────────────
# ABaaS — miljøvariabler (eksempel). Kopiér til .env.local og udfyld.
#
# INGEN rigtige secrets i repo (.gitignore dækker .env*). Alle nøgler nedenfor
# afventer account-oprettelse — ejerne opretter accounts og giver Mads adgang.
# Indtil da kører hver sub-processor-adapter som STUB, og feature-flagene er OFF.
# Prod-runtime-secrets sættes i Netlify > Environment variables (hosting = Netlify, ADR 0012).
# ─────────────────────────────────────────────────────────────────────────────

# --- Feature-flags (default OFF; sæt =true for at aktivere en konfigureret adapter) ---
FLAG_BOOKING=
FLAG_VIDEO=
FLAG_PAYMENTS=
FLAG_ACCOUNTING=
FLAG_AIFOLLOWUP=
FLAG_TRANSCRIPTION=
FLAG_EMAIL=
FLAG_SMS=
FLAG_ANALYTICS=
# inAppMessaging udelades bevidst — modulet er uafklaret og kan ikke aktiveres via env.

# --- Demo-tilstand (ADR 0041): dummy-implementeringer for de moduler der IKKE har nøgler ---
# Rigtige nøgler vinder altid over demo. Alt demo returnerer er åbenlyst falsk (DEMO-/[DEMO]).
# Slås FRA før launch (docs/fase-6.md §6.4).
FLAG_DEMO=

# --- Database (Supabase Postgres) — region eu-north-1 (Stockholm), jf. ADR 0013 ---
DATABASE_URL=
# db-tests mod lokal Postgres-container (docker-compose.test.yml):
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abaas_test

# --- Supabase Auth (auth-valg = Supabase Auth, ADR 0013) ---
# URL + anon-nøgle er offentlige by design (klient-eksponeret via NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role-nøgle: SERVER-ONLY hemmelighed — ALDRIG NEXT_PUBLIC_. Bruges kun server-side
# til rolle-opslag (bypasser RLS bevidst). Uden alle tre kører auth som stub (kontofri CI).
SUPABASE_SERVICE_ROLE_KEY=

# --- Adgangsport (ADR 0020) — delt adgangskode før auth. BRUGES IKKE p.t. (Mads, 2026-08-26);
# variablerne er dokumenteret her fordi koden findes. Alle tre skal sættes for at porten er aktiv.
# Hash genereres med `node scripts/hash-gate-password.mjs <kodeord>` — aldrig kodeordet i klartekst.
APP_GATE_ENABLED=
APP_GATE_PASSWORD_HASH=
APP_GATE_COOKIE_SECRET=

# --- Cal.com (booking, fase 2) — plan = TEAMS (ADR 0046). Platform-planen er lukket for
# nye kunder. Sæder = rådgivere + admin; ejere/kunder er attendees og koster ingen sæder.
# EU-residens på Teams er STADIG uverificeret (spike L-7) — gate før produktionsdata.
CALCOM_API_KEY=
# Teams-kontoens id — bruges KUN når admin opretter boardets collective event type
# (POST /v2/teams/{teamId}/event-types). Event type-id'et pr. board er IKKE env: det er
# tilstand i Supabase (board.calcom_event_type_id, migration 0019, ADR 0046).
CALCOM_TEAM_ID=
# Valgfri: afviger ved cal.eu/self-host (default https://api.cal.com/v2).
CALCOM_API_URL=
# Webhook-signaturhemmelighed (SERVER-ONLY). Uden den svarer webhook-endpointet 503 —
# signaturverifikation stubbes aldrig (docs/stub-politik.md, ADR 0027).
CALCOM_WEBHOOK_SECRET=

# --- Cal Video (multi-party video; optagelse ejes af Cal.com) ---
CALVIDEO_API_KEY=

# --- Alunta (betaling ind, ADR 0023/0032) — dansk udbyder; dataflow verificeret mod
# OpenAPI-spec'en. Bearer-token fra Alunta (Laravel Passport OAuth2).
ALUNTA_API_KEY=
# Den FLAT-RATE-plan checkout-sessions oprettes mod (ADR 0056; ikke usage-plan). Planens pris er
# en pladsholder: vores pricing_rule beregner beløbet og sætter det på abonnementet pr. periode.
# ⚠ Alunta fakturerer i måneder, ikke uger — kadencen er et åbent Mads-punkt (backlog B-35).
ALUNTA_PLAN_ID=
# Valgfri: afviger kun ved test-/self-host (default https://app.alunta.com/api/v1).
ALUNTA_API_URL=
# Webhook-signaturhemmelighed (SERVER-ONLY; sættes også i Alunta-UI'ets webhook-opsætning).
# Uden den svarer webhook-endpointet 503 — signaturverifikation stubbes aldrig (ADR 0027).
ALUNTA_WEBHOOK_SECRET=

# --- Planlagt kørsel: periode-opkrævninger (B-19, ADR 0056) ---
# Delt hemmelighed mellem Netlify scheduled function (netlify/functions/charge-periods.ts) og
# /api/cron/charge-periods (SERVER-ONLY). Uden den svarer routen 503 og funktionen kalder intet —
# kørslen åbnes aldrig uden hemmelighed. Generér en lang tilfældig streng; sæt den i Netlify env vars.
CRON_SECRET=

# --- Bogføring ud (e-conomic ELLER Dinero — leverandørvalg uafklaret hos ejer) ---
ACCOUNTING_API_KEY=

# --- Ordbogen / OdinCore (chat.dk + ordbogen.ai → odincore.ai) — dansk datacenter, ADR 0024/0058.
# Én konto dækker LLM og transskription: sæt den FÆLLES nøgle, eller de to specifikke hvis
# Ordbogen udsteder nøgler pr. projekt (en specifik nøgle vinder over den fælles).
# Gatewayen er OpenAI-kompatibel (docs/spikes/ordbogen-api.md). Nøglen sendes kun over https.
ORDBOGEN_API_KEY=
# Valgfri overstyringer — tom = dokumenteret default (https://api.odincore.ai/v1, odin-2, whisper-1).
# Modelnavnene er spec'ens eksempler og skal verificeres mod GET /v1/models (TODO(mads)).
ORDBOGEN_API_URL=
ORDBOGEN_LLM_MODEL=
ORDBOGEN_TRANSCRIPTION_MODEL=
# Porterne forbliver leverandørneutrale (ADR 0004), derfor de generiske navne som specifik override.
LLM_API_KEY=
# 🔴 Transskription kræver ejerens samtykkeflow til mødeoptagelse — uden det fejler den lukket
# (RecordingConsentMissingError), uanset nøgle og flag. Samtykke stubbes aldrig.
TRANSCRIPTION_API_KEY=

# --- Resend (transaktionsmails, EU Dublin) — notifikationsmotoren, ADR 0057 ---
# Kræver FLAG_EMAIL=true. Uden nøgler: demo (FLAG_DEMO) eller stub — aldrig en stille afsendelse.
# 🔴 EU-REGION vælges på AFSENDERDOMÆNET i Resend-UI'et (Domains → Add Domain → Region
#    `eu-west-1`, Irland/Dublin) — IKKE i API-kaldet og ikke i nøglen. Opret domænet i EU FØR
#    nøglen bruges. TODO(mads): bekræft regionen og notér den i docs/gdpr/leverandoer-register.md.
RESEND_API_KEY=
# Afsender på det verificerede domæne, fx `Navn <adresse@domæne>`.
RESEND_FROM_ADDRESS=

# --- inMobile (SMS, dansk) — kræver FLAG_SMS=true ---
# ⚠ Adapteren er bygget mod bedste forståelse af inMobile API v4 og aldrig kørt mod en konto
#    (TODO(mads): verificér mod inMobile live — se src/lib/sms/inmobile.ts). SMS kan desuden
#    ikke sendes før telefonnumre findes i datamodellen (docs/stub-register.md).
INMOBILE_API_KEY=
# Afsendernavn (alfanumerisk) eller -nummer.
INMOBILE_SENDER=

# --- Notifikationer: absolut app-URL til links i beskeder ---
# Bruges også af betalingens success/back-URL'er. Uden den kan en besked med {{link}} ikke
# sendes (udsendelsen logges som fejlet: «variablen link har ingen værdi»).
NEXT_PUBLIC_APP_URL=
# Den beskyttede planlagte rute /api/cron/notifications (ADR 0057) bruger CRON_SECRET i headeren
# `x-cron-secret` — samme variabel som betalingens planlagte kørsel; sættes ÉT sted (Netlify).
# Ruten er IKKE planlagt, og ingen planlagt besked sendes, før ejeren har fastsat tidspunkterne.

# --- PostHog (analytics + fejlovervågning, EU) — fase 0, live-nøgle afventer ---
POSTHOG_KEY=
POSTHOG_HOST=https://eu.posthog.com
